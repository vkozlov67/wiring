[Unit]
Description=Deliver consenting WIRING registration conversions
After=network-online.target wiring-places.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/
EnvironmentFile=/etc/wiring-registration-worker.env
ExecStart=/opt/wiring-places/current/wiring-beta-places sync-registrations
TimeoutStartSec=5min
UMask=0077
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
