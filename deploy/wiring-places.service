[Unit]
Description=WIRING Rust place catalog
After=network.target

[Service]
DynamicUser=yes
Environment=WIRING_PLACES_CATALOG=/opt/wiring-places/current/catalog
ExecStart=/opt/wiring-places/current/wiring-beta-places
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
