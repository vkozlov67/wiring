[Unit]
Description=Erase WIRING accounts past the restore window
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/wiring-places/current
Environment=UPLOAD_DIR=/var/lib/wiring/uploads
EnvironmentFile=/etc/wiring-purge-rust.env
ExecStart=/opt/wiring-places/current/wiring-beta-places purge-accounts --apply
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/wiring/uploads
