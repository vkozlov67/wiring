[Unit]
Description=Sync consenting WIRING contacts to SendPulse
After=network-online.target wiring-places.service
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
EnvironmentFile=/etc/wiring-sendpulse-rust.env
ExecStart=/opt/wiring-places/current/wiring-beta-places sync-sendpulse
TimeoutStartSec=10min
UMask=0077
