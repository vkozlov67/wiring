# Local dev defaults (copy to .env and edit). See README.
# Manual browser testing on http://127.0.0.1:5070/:
#   main login — dev@wiring.test / wiring-dev (Дев)
#   chat peer — peer@wiring.test / wiring-dev (Пир)
HOST=127.0.0.1
PORT=5070
FLASK_DEBUG=1
# Local dev: Postgres via docker compose (PostgreSQL is the only supported DB).
# Moderator report/ban email uses this inbox and the existing Resend/SMTP transport.
SUPPORT_INBOX=
DATABASE_URL=postgresql://wiring_dev:wiring_dev@127.0.0.1:5433/wiring_dev
# Production: set DATABASE_URL in /etc/wiring.env (see README Deploy).
# APP_SECRET_KEY=
# SITE_URL=http://127.0.0.1:5070
# Optional internal Rust routes. Leave empty to use Flask.
# WIRING_PLACES_SEARCH_URL=http://127.0.0.1:5081/search
# WIRING_PLACES_CATALOG_URL=http://127.0.0.1:5081/catalog
# WIRING_FEED_FILTER_URL=http://127.0.0.1:5081/feed/filter
# WIRING_FEED_UPDATE_URL=http://127.0.0.1:5081/feed/update
# WIRING_FEED_CLAIM_URL=http://127.0.0.1:5081/feed/claim
# WIRING_FEED_SWIPE_URL=http://127.0.0.1:5081/feed/swipe
# WIRING_CHAT_THREAD_URL=http://127.0.0.1:5081/chat/thread
# WIRING_CHAT_SEND_URL=http://127.0.0.1:5081/chat/send
# WIRING_CHAT_MUTATE_URL=http://127.0.0.1:5081/chat/mutate
# WIRING_CHAT_HISTORY_URL=http://127.0.0.1:5081/chat/history
# WIRING_CHAT_MEDIA_URL=http://127.0.0.1:5081/chat/send
# WIRING_CHAT_PAIR_URL=http://127.0.0.1:5081/chat/pair
# WIRING_CHAT_TRANSCRIBE_URL=http://127.0.0.1:5081/chat/mutate
# WIRING_CHAT_INBOX_URL=http://127.0.0.1:5081/chat/inbox
# WIRING_CHAT_MATCHES_URL=http://127.0.0.1:5081/chat/matches
# WIRING_NOTICES_URL=http://127.0.0.1:5081/notices/query
# WIRING_PASSWORD_URL=http://127.0.0.1:5081/auth/password
# WIRING_MOBILE_REFRESH_URL=http://127.0.0.1:5081/auth/refresh
# WIRING_MOBILE_LOGOUT_URL=http://127.0.0.1:5081/auth/logout
# WIRING_MOBILE_ISSUE_URL=http://127.0.0.1:5081/auth/issue
# WIRING_PROFILE_SETTINGS_URL=http://127.0.0.1:5081/profile/settings
# Optional analytics counters. Leave blank locally to avoid production telemetry.
# GOOGLE_ANALYTICS_ID=
# YANDEX_METRIKA_ID=
# Server-only Measurement Protocol secret from the same counter (never send to browsers).
# YANDEX_METRIKA_MEASUREMENT_SECRET=

# Optional Jev recommendations. Access requires redeeming WIRINGFORYOU, then profile opt-in.
# Keep the API key server-side. Locally use ignored .env; production uses /etc/wiring.env.
JEV_API_KEY=
JEV_MODEL=jev-latest
# Optional contact sync. Only verified accounts with marketing consent are added.
# Static SendPulse API key (not OAuth client secret); keep blank for local tests.
SENDPULSE_API_KEY=
SENDPULSE_ADDRESSBOOK_ID=
# Voice transcription in chats. Same key as photo moderation. Leave blank to hide working transcription.
# OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# Unknown city spelling validation; falls back to OPENAI_MODEL or gpt-4o-mini.
# OPENAI_CITY_MODEL=gpt-4o-mini
# Signup WIRING+ gift. Unset or 1 grants 90 days to every new account. Set to 0 to stop.
# Existing grants stay until they expire. Guests are not included.
# WIRING_SIGNUP_PLUS=1
# Optional Web Push key override. If unset, the server stores a key pair in push_vapid.
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:noreply@wiring.date

# Optional social login. Buttons appear only when both values for a provider are set.
# Use separate development OAuth apps; never copy production secrets locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Apple: Services ID and signed ES256 client-secret JWT (rotate before expiry).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# SITE_URL must match the browser origin (local: http://127.0.0.1:5070).
# Callback URLs: ${SITE_URL}${BASE_PATH}/api/auth/{google,yandex,apple}/callback.
# Apple requires a registered HTTPS domain (no localhost/IP callback).
# Production also requires a stable APP_SECRET_KEY and SESSION_COOKIE_SECURE=1.
# Optional additional trusted origins, each with a registered callback at enabled providers.
# This keeps OAuth state cookies on the host where the user started.
# OAUTH_ALLOWED_ORIGINS=https://wiring.club,https://wiring.date

# Public SHA-256 release signing certificate fingerprints for Android App Links (comma-separated).
# Never put signing keys here; leave empty until the signed build certificate is known.
ANDROID_APP_LINK_SHA256=
# Beta app links on /m. Empty keeps the "coming soon" placeholder on the buttons.
# WIRING_TESTFLIGHT_URL=https://testflight.apple.com/join/XXXXXXXX
# WIRING_ANDROID_APK_URL=https://wiring.club/downloads/wiring.apk
